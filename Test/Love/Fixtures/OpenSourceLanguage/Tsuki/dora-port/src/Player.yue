love = require "love"
import "src.util.Vector2"

{
    graphics: lg,
    keyboard: lk,
} = love

export class Player
    new: () =>
        @position = Vector2.Vector2(lg.getWidth! / 2, lg.getHeight! / 2)
        @speed = 500
        @sprite = lg.newImage("assets/moon.png")
        @sprite_width, @sprite_height = @sprite\getDimensions!

    update: (dt) =>
        dir = Vector2.Zero()
        if lk.isDown("up")
            dir += Vector2.Down()
        if lk.isDown("down")
            dir += Vector2.Up()
        if lk.isDown("left")
            dir += Vector2.Left()
        if lk.isDown("right")
            dir += Vector2.Right()
        @\move(dir * dt)

    move: (dir) =>
        @position = @position + (dir * @speed)
        @position\clamp(0, 0,
            lg.getWidth! - @sprite_width, lg.getHeight! - @sprite_height)

    draw: () =>
        lg.draw(@sprite, @position.x, @position.y)
