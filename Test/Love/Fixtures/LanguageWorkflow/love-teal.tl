local type Love = require("love")
local love = require("love")
local record ContactLike
	getFixtures: function(self: ContactLike): any, any
	getChildren: function(self: ContactLike): integer, integer
	getPositions: function(self: ContactLike): number...
	getNormal: function(self: ContactLike): number, number
	getFriction: function(self: ContactLike): number
	setFriction: function(self: ContactLike, value: number)
	getRestitution: function(self: ContactLike): number
	setRestitution: function(self: ContactLike, value: number)
	getTangentSpeed: function(self: ContactLike): number
	setTangentSpeed: function(self: ContactLike, value: number)
	isEnabled: function(self: ContactLike): boolean
	setEnabled: function(self: ContactLike, value: boolean)
	isTouching: function(self: ContactLike): boolean
end
local elapsed = 0.0
love.filesystem.setIdentity("typed-love-save")
local saveDirectory: string = love.filesystem.getSaveDirectory()
local directoryItems: {string} = love.filesystem.getDirectoryItems()
local requirePath: string = love.filesystem.getRequirePath()
love.filesystem.setRequirePath("custom/?.lua;" .. requirePath)
local timerTime: number = love.timer.getTime()
if false then
	love.event.pump()
	local nextEvent = love.event.poll()
	local eventName = nextEvent()
	local waitedEvent = love.event.wait()
	local pushedEvent: boolean = love.event.push("typed", true, 7, "value")
	local restartQueued: boolean = love.event.quit("restart")
	love.event.clear()
	local systemOS: string = love.system.getOS()
	local processorCount: integer = love.system.getProcessorCount()
	local powerState, powerPercent, powerSeconds = love.system.getPowerInfo()
	local openedURL: boolean = love.system.openURL("https://example.com")
	love.system.vibrate(0.25)
	print(eventName, waitedEvent, pushedEvent, restartQueued, systemOS, processorCount, powerState, powerPercent, powerSeconds, openedURL, love.system.hasBackgroundMusic())
end
local typedFile = love.filesystem.newFile("typed.bin")
local typedFileData = love.filesystem.newFileData("abc", "typed.bin")
local legacyExists: boolean = love.filesystem.exists("typed.bin")
local legacySize, legacySizeError = love.filesystem.getSize("typed.bin")
local typedImageData = love.image.newImageData(2, 2)
typedImageData:mapPixel(function(_x: integer, _y: integer, red: number, green: number, blue: number, alpha: number): number, number, number, number
	return red, green, blue, alpha
end)
typedImageData:paste(typedImageData, 0, 0)
local typedPng = typedImageData:encode("png")
if false then
	local typedCompressedImage = love.image.newCompressedData(typedFileData)
	local typedCompressedWidth: integer = typedCompressedImage:getWidth()
	local typedCompressedFormat: string = typedCompressedImage:getFormat()
	local typedIsCompressed: boolean = love.image.isCompressed(typedFileData)
	local typedCompressedTexture = love.graphics.newImage(typedCompressedImage, {mipmaps = true})
	print(typedCompressedWidth, typedCompressedFormat, typedIsCompressed, typedCompressedTexture:getWidth())
end
local typedFont = love.graphics.newFont(18)
typedFont:setFallbacks(love.graphics.newFont(18))
typedFont:setLineHeight(1.25)
local typedAscent: number = typedFont:getAscent()
local typedDescent: number = typedFont:getDescent()
local typedKerning: number = typedFont:getKerning("A", "V")
local typedGlyphs: boolean = typedFont:hasGlyphs("Love", 65)
local typedText = love.graphics.newText(typedFont, {{1, 0.5, 0, 1}, "typed", {0, 0.5, 1, 1}, " text"})
local typedTextIndex: integer = typedText:addf("justified text", 160, "justify", love.math.newTransform(10, 20))
local typedTextWidth, typedTextHeight = typedText:getDimensions(typedTextIndex)
typedText:setFont(typedFont)
love.graphics.draw(typedText, 10, 20)
local typedBatchImage = love.graphics.newImage(love.image.newImageData(16, 16))
local typedBatch = love.graphics.newSpriteBatch(typedBatchImage, 8, "dynamic")
local typedBatchIndex: integer = typedBatch:add(4, 8)
typedBatch:set(typedBatchIndex, love.graphics.newQuad(0, 0, 8, 8, typedBatchImage), 12, 16)
typedBatch:setColor({1, 0.5, 0.25, 1})
typedBatch:setDrawRange(1, 1)
love.graphics.draw(typedBatch, 0, 0)
local typedParticles = love.graphics.newParticleSystem(typedBatchImage, 32)
typedParticles:setParticleLifetime(1, 2)
typedParticles:setEmissionRate(20)
typedParticles:setEmissionArea("uniform", 4, 6, 0, true)
typedParticles:setSpeed(10, 20)
typedParticles:setLinearAcceleration(0, 10, 0, 20)
typedParticles:setSizes(1, 0.5, 0)
typedParticles:setColors({1, 0.5, 0, 1}, {0, 0, 1, 0})
typedParticles:setQuads({love.graphics.newQuad(0, 0, 8, 8, typedBatchImage)})
typedParticles:emit(4)
typedParticles:update(1 / 60)
local particleLifeMin, particleLifeMax = typedParticles:getParticleLifetime()
local particleDistribution, particleAreaX = typedParticles:getEmissionArea()
local typedParticleClone = typedParticles:clone()
love.graphics.draw(typedParticles, 0, 0)
print(particleLifeMin, particleLifeMax, particleDistribution, particleAreaX, typedParticleClone)
typedFile:open("w")
typedFile:write(typedFileData)
typedFile:close()
print(saveDirectory, #directoryItems, timerTime)
print(typedPng:getFilename())
print(typedAscent, typedDescent, typedKerning, typedGlyphs, typedFont:getLineHeight())
print(typedTextWidth, typedTextHeight)
love.keyboard.setKeyRepeat(true)
local repeatEnabled: boolean = love.keyboard.hasKeyRepeat()
local scan: string = love.keyboard.getScancodeFromKey("a")
local key: string = love.keyboard.getKeyFromScancode(scan)
local scanDown: boolean = love.keyboard.isScancodeDown(scan)
local screenKeyboard: boolean = love.keyboard.hasScreenKeyboard()
love.keyboard.setTextInput(true, 20, 30, 160, 24)
local textInputActive: boolean = love.keyboard.hasTextInput()
print(repeatEnabled, key, scanDown, screenKeyboard, textInputActive)

love.textedited = function(text: string, start: integer, length: integer)
	print(text, start, length)
end

love.touchpressed = function(id: Love.TouchID, x: number, y: number, deltaX: number, deltaY: number, pressure: number)
	local touchX, touchY = love.touch.getPosition(id)
	local currentPressure: number = love.touch.getPressure(id)
	print(touchX, touchY, currentPressure, x, y, deltaX, deltaY, pressure, #love.touch.getTouches())
end

love.gamepadpressed = function(joystick: Love.Joystick, button: string)
	local connected: boolean = joystick:isConnected()
	local down: boolean = joystick:isGamepadDown(button)
	local axis: number = joystick:getGamepadAxis("leftx")
	print(connected, down, axis)
end

local function checkFilesystemTypes()
	local loadedChunk, loadedError = love.filesystem.load("module.lua")
	local lineIterator = love.filesystem.lines("notes.txt")
	print(loadedChunk, loadedError, lineIterator)
end

local function checkAudioTypes()
	love.audio.setVolume(0.75)
	local instanceVolume: number = love.audio.getVolume()
	love.audio.setPosition(10, 20)
	love.audio.setOrientation(0, 0, 1, 0, 1, 0)
	love.audio.setVelocity(1, 2, 3)
	love.audio.setDopplerScale(1.5)
	local dopplerScale: number = love.audio.getDopplerScale()
	love.audio.setDistanceModel("linearclamped")
	local distanceModel: string = love.audio.getDistanceModel()
	local listenerX, listenerY, listenerZ = love.audio.getPosition()
	local forwardX, forwardY, forwardZ, upX, upY, upZ = love.audio.getOrientation()
	local velocityX, velocityY, velocityZ = love.audio.getVelocity()
	local source = love.audio.newSource("sound.wav", "static")
	local queueData = love.sound.newSoundData(64, 8000, 16, 1)
	local queueSource = love.audio.newQueueableSource(8000, 16, 1, 4)
	local queued: boolean = queueSource:queue(queueData)
	local queuedRegion: boolean = queueSource:queue(queueData, 0, 32)
	local freeBuffers: integer = queueSource:getFreeBufferCount()
	local sourceClone = source:clone()
	local sourceDuration: number = source:getDuration("seconds")
	local sourceChannels: integer = source:getChannelCount()
	local sourceChannelsDeprecated: integer = source:getChannels()
	source:setPosition(1, 2)
	source:setVelocity(3, 4, 5)
	source:setDirection(0, 0, -1)
	source:setCone(math.pi / 2, math.pi, 0.25, 0.5)
	source:setAirAbsorption(2)
	source:setVolumeLimits(0.1, 0.9)
	source:setRelative(true)
	source:setAttenuationDistances(1, 1000)
	source:setRolloff(0.5)
	local sourceX, sourceY, sourceZ = source:getPosition()
	local sourceVelocityX, sourceVelocityY, sourceVelocityZ = source:getVelocity()
	local sourceDirectionX, sourceDirectionY, sourceDirectionZ = source:getDirection()
	local coneInner, coneOuter, coneVolume, coneHighGain = source:getCone()
	local airAbsorption = source:getAirAbsorption()
	local minVolume, maxVolume = source:getVolumeLimits()
	local referenceDistance, maxDistance = source:getAttenuationDistances()
	local sourceRelative = source:isRelative()
	local sourceRolloff = source:getRolloff()
	source:setVolume(0.5)
	source:setPitch(1.25)
	source:setLooping(true)
	source:seek(2.0, "seconds")
	local started: boolean = love.audio.play({source, sourceClone})
	local pausedSources = love.audio.pause()
	local activeSources: integer = love.audio.getActiveSourceCount()
	local activeSourcesDeprecated: integer = love.audio.getSourceCount()
	print(started, instanceVolume, listenerX, listenerY, listenerZ,
		forwardX, forwardY, forwardZ, upX, upY, upZ, velocityX, velocityY, velocityZ,
		sourceClone, sourceDuration, sourceChannels,
		sourceChannelsDeprecated, sourceX, sourceY, sourceZ,
		sourceVelocityX, sourceVelocityY, sourceVelocityZ,
		sourceDirectionX, sourceDirectionY, sourceDirectionZ,
		coneInner, coneOuter, coneVolume, coneHighGain, minVolume, maxVolume,
		referenceDistance, maxDistance,
		sourceRelative, sourceRolloff, dopplerScale, distanceModel, pausedSources, activeSources, activeSourcesDeprecated,
		queueSource, queued, queuedRegion, freeBuffers)
	love.audio.pause({source, sourceClone})
	love.audio.pause(source)
	love.audio.stop({source, sourceClone})
	love.audio.stop(source)
end

local function checkDecoderTypes()
	local typedDecoder = love.sound.newDecoder(typedFileData, 4096)
	local decodedChunk = typedDecoder:decode()
	typedDecoder:seek(0)
	local expandedDecoder = love.sound.newSoundData(typedDecoder)
	print(decodedChunk, expandedDecoder)
end

local function checkMathTypes()
	local typedRandom = love.math.newRandomGenerator(1, 2)
	local typedRandomValue: number = typedRandom:random(1, 6)
	local seedLow, seedHigh = typedRandom:getSeed()
	typedRandom:setState(typedRandom:getState())
	local typedTriangles: {{number}} = love.math.triangulate({0, 0, 1, 0, 0, 1})
	local red, green, blue = love.math.colorToBytes(1, 0.5, 0)
	local typedNoise: number = love.math.noise(0.25, 0.5, 0.75)
	local typedTransform = love.math.newTransform(1, 2)
	local pointX, pointY = typedTransform:transformPoint(3, 4)
	local typedCurve = love.math.newBezierCurve({0, 0, 10, 20, 20, 0})
	local curveX, curveY = typedCurve:evaluate(0.5)
	print(typedRandomValue, seedLow, seedHigh, typedTriangles, red, green, blue, typedNoise, pointX, pointY, curveX, curveY)
end

local function checkDataTypes()
	local bytes = love.data.newByteData("abcdef")
	local view = love.data.newDataView(bytes, 1, 4)
	local encoded = love.data.encode("data", "base64", view)
	local compressed = love.data.compress("data", "lz4", encoded)
	local decompressed = love.data.decompress("data", compressed)
	local digest: string = love.data.hash("sha256", view)
	local packed = love.data.pack("data", "<I2", 7)
	local number, nextPosition = love.data.unpack("<I2", packed)
	local packedSize: integer = love.data.getPackedSize("<I2")
	local legacy = love.math.compress("data", "gzip", bytes)
	print(decompressed, digest, number, nextPosition, packedSize, legacy)
end

local function checkQuadTypes()
	local image = love.graphics.newImage(love.image.newImageData(16, 16))
	local canvas = love.graphics.newCanvas(64, 32, {
		dpiscale = 1,
		msaa = 0,
		format = "rgba8",
		type = "2d",
		readable = true,
		mipmaps = "none",
	})
	local canvasWidth: integer = canvas:getPixelWidth()
	local readback = canvas:newImageData(1, 1, 0, 0, 16, 8)
	canvas:setFilter("nearest")
	love.graphics.setCanvas(canvas)
	local currentCanvas = love.graphics.getCanvas()
	love.graphics.setCanvas()
	local quad = love.graphics.newQuad(0, 0, 16, 16, image)
	local canvasQuad = love.graphics.newQuad(0, 0, 16, 16, canvas)
	local x, y, width, height = quad:getViewport()
	quad:setViewport(x, y, width, height)
	love.graphics.draw(image, quad, 20, 30)
	love.graphics.draw(canvas, canvasQuad, 0, 0)
	print(canvasWidth, readback, currentCanvas)
end

local function checkMeshTypes()
	local mesh = love.graphics.newMesh({
		{0, 0, 0, 0, 255, 255, 255, 255},
		{32, 0, 1, 0, 255, 255, 255, 255},
		{0, 32, 0, 1, 255, 255, 255, 255},
	}, "triangles", "static")
	mesh:setVertexMap(1, 2, 3)
	mesh:setDrawRange(1, 3)
	local vertex = mesh:getVertex(1)
	local format = mesh:getVertexFormat()
	local count: integer = mesh:getVertexCount()
	local packedMesh = love.graphics.newMesh({
		{"VertexPosition", "float", 2},
		{"VertexColor", "byte", 4},
	}, typedFileData, "triangles", "stream")
	packedMesh:setVertices(typedFileData, 1, 1)
	packedMesh:setVertexMap(typedFileData, "uint16", 1)
	mesh:attachAttribute("VertexPosition", packedMesh, "pervertex", "VertexPosition")
	mesh:setAttributeEnabled("VertexPosition", true)
	local positionEnabled: boolean = mesh:isAttributeEnabled("VertexPosition")
	local detached: boolean = mesh:detachAttribute("VertexPosition")
	love.graphics.setDepthMode("less", true)
	local depthCompare, depthWrite = love.graphics.getDepthMode()
	love.graphics.setMeshCullMode("back")
	love.graphics.setFrontFaceWinding("ccw")
	love.graphics.draw(mesh, 10, 10)
	love.graphics.drawInstanced(mesh, 2, 10, 10, 0, 1, 1, 0, 0, 0.1, 0.2)
	love.graphics.setDepthMode()
	print(vertex, format, count, positionEnabled, detached, depthCompare, depthWrite)
end

local function checkShaderTypes()
	local shader = love.graphics.newShader([[
		extern vec3 tint;
		vec4 effect(vec4 color, Image texture, vec2 uv, vec2 screen) {
			return vec4(tint, 1.0) * color;
		}
	]])
	shader:sendColor("tint", {1, 0.5, 0})
	shader:send("tint", 1, 0.5, 0)
	shader:send("enabled", true)
	shader:send("weights", 0.25, 0.5, 1)
	shader:send("offsets", {2, -2}, {4, -4})
	shader:send("gates", {true, false}, {false, true})
	shader:send("basis", {1, 2, 3, 4})
	shader:send("frames", "column", {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}})
	shader:send("packed", typedFileData, 0, 16)
	shader:send("packedMatrix", "row", typedFileData, 0, 16)
	shader:send("packedMatrix", typedFileData, "column", 0, 16)
	shader:sendColor("packedColor", typedFileData, 0, 16)
	shader:send("mask", love.graphics.newImage("fixture.png"))
	shader:send("overlay", love.graphics.newCanvas(8, 8))
	shader:send("layers", love.graphics.newImage("fixture.png"), love.graphics.newCanvas(8, 8))
	local hasTint: boolean = shader:hasUniform("tint")
	local warnings: string = shader:getWarnings()
	local valid, validationError = love.graphics.validateShader(false, typedFileData)
	love.graphics.setShader(shader)
	local currentShader = love.graphics.getShader()
	love.graphics.setShader()
	print(hasTint, warnings, valid, validationError, currentShader)
end

local function checkPhysicsTypes()
	love.physics.setMeter(64)
	local meter: number = love.physics.getMeter()
	local world = love.physics.newWorld(0, 9.81 * meter, true)
	local worldDestroyed: boolean = world:isDestroyed()
	world:setSleepingAllowed(world:isSleepingAllowed())
	local body = love.physics.newBody(world, 100, 40, "dynamic")
	local bodyDestroyed: boolean = body:isDestroyed()
	local circle = love.physics.newCircleShape(12)
	local rectangle = love.physics.newRectangleShape(0, 0, 80, 16, 0.25)
	local polygon = love.physics.newPolygonShape({0, 0, 20, 0, 10, 15})
	local polygonVarargs = love.physics.newPolygonShape(0, 0, 12, 0, 6, 9)
	local edge = love.physics.newEdgeShape(-20, 0, 20, 0)
	local chain = love.physics.newChainShape(false, {-20, 0, 0, -10, 20, 0})
	local loopChain = love.physics.newChainShape(true, 0, 0, 20, 0, 10, 15)
	local chainCount = chain:getVertexCount()
	local chainX, chainY = loopChain:getPoint(4)
	local edgeX, edgeY = edge:getPoints()
	local childEdge = chain:getChildEdge(1)
	local previousX, previousY = childEdge:getPreviousVertex()
	local nextX, nextY = childEdge:getNextVertex()
	edge:setPreviousVertex()
	edge:setNextVertex(30, 0)
	chain:setPreviousVertex(-30, 0)
	chain:setNextVertex()
	local polygonValid = polygon:validate() and polygonVarargs:validate()
	local fixture = love.physics.newFixture(body, circle, 1)
	local fixtureDestroyed: boolean = fixture:isDestroyed()
	fixture:setFriction(0.5)
	fixture:setRestitution(0.2)
	fixture:setSensor(false)
	fixture:setDensity(fixture:getDensity())
	fixture:getType()
	fixture:getBody()
	fixture:getShape()
	fixture:testPoint(10, 20)
	fixture:rayCast(0, 0, 20, 20, 1)
	fixture:getBoundingBox()
	fixture:getMassData()
	fixture:setFilterData(1, 65535, 0)
	fixture:getFilterData()
	fixture:setCategory(1, 3)
	fixture:getCategory()
	fixture:setMask({2, 4})
	fixture:getMask()
	fixture:setGroupIndex(fixture:getGroupIndex())
	fixture:setUserData({kind = "fixture"})
	fixture:getUserData()
	body:setLinearVelocity(1, 2)
	body:setX(body:getX())
	body:setY(body:getY())
	body:setTransform(10, 20, 0.5)
	body:getTransform()
	body:getWorldPoint(1, 2)
	body:getWorldVector(1, 2)
	body:getWorldPoints(1, 2, 3, 4)
	body:getLocalPoint(1, 2)
	body:getLocalVector(1, 2)
	body:getLocalPoints(1, 2, 3, 4)
	body:getLinearVelocityFromWorldPoint(1, 2)
	body:getLinearVelocityFromLocalPoint(1, 2)
	body:applyLinearImpulse(3, 4)
	body:setAngularVelocity(0.5)
	body:setLinearDamping(0.2)
	body:setAngularDamping(0.3)
	body:setFixedRotation(true)
	body:setAwake(body:isAwake())
	body:setSleepingAllowed(body:isSleepingAllowed())
	body:setActive(body:isActive())
	body:setBullet(body:isBullet())
	body:setType("kinematic")
	body:setType("dynamic")
	body:applyAngularImpulse(0.1)
	body:applyForce(4, 5)
	body:applyForce(4, 5, 100, 40)
	body:applyTorque(0.2)
	local positionX, positionY = body:getPosition()
	local angularVelocity = body:getAngularVelocity()
	local linearDamping = body:getLinearDamping()
	local angularDamping = body:getAngularDamping()
	local mass = body:getMass()
	local inertia = body:getInertia()
	local centerMassX, centerMassY, massDataMass, massDataInertia = body:getMassData()
	body:setMass(mass)
	body:setInertia(inertia)
	body:setMassData(centerMassX, centerMassY, massDataMass, massDataInertia)
	body:resetMassData()
	body:setGravityScale(body:getGravityScale())
	local localCenterX, localCenterY = body:getLocalCenter()
	local worldCenterX, worldCenterY = body:getWorldCenter()
	local fixedRotation = body:isFixedRotation()
	local awake = body:isAwake()
	local sleepingAllowed = body:isSleepingAllowed()
	local active = body:isActive()
	local bullet = body:isBullet()
	local pointX, pointY = rectangle:getPoints()
	local anchor = love.physics.newBody(world, 0, 0, "static")
	local joint = love.physics.newDistanceJoint(anchor, body, 0, 0, 100, 40, false)
	local revolute = love.physics.newRevoluteJoint(anchor, body, 0, 0, 0, 0, false, 0.1)
	revolute:setMotorEnabled(true)
	revolute:setMaxMotorTorque(100)
	revolute:setMotorSpeed(2)
	revolute:setLimits(-0.5, 0.5)
	revolute:setLimitsEnabled(true)
	local revoluteAngle: number = revolute:getJointAngle()
	local revoluteSpeed: number = revolute:getJointSpeed()
	local revoluteTorque: number = revolute:getMotorTorque(60)
	local revoluteReference: number = revolute:getReferenceAngle()
	local revoluteEnabled: boolean = revolute:areLimitsEnabled()
	local prismatic = love.physics.newPrismaticJoint(anchor, body, 0, 0, 0, 0, 1, 0, false, 0.1)
	prismatic:setMotorEnabled(true)
	prismatic:setMaxMotorForce(100)
	prismatic:setMotorSpeed(20)
	prismatic:setLimits(-10, 50)
	prismatic:setLimitsEnabled(true)
	local prismaticTranslation: number = prismatic:getJointTranslation()
	local prismaticSpeed: number = prismatic:getJointSpeed()
	local prismaticForce: number = prismatic:getMotorForce(60)
	local prismaticAxisX, prismaticAxisY = prismatic:getAxis()
	local prismaticReference: number = prismatic:getReferenceAngle()
	local weld = love.physics.newWeldJoint(anchor, body, 0, 0, 0, 0, false, 0.1)
	weld:setFrequency(5)
	weld:setDampingRatio(0.6)
	local weldFrequency: number = weld:getFrequency()
	local weldDamping: number = weld:getDampingRatio()
	local weldReference: number = weld:getReferenceAngle()
	local friction = love.physics.newFrictionJoint(anchor, body, 0, 0, 0, 0, false)
	friction:setMaxForce(100)
	friction:setMaxTorque(1000)
	local frictionForce: number = friction:getMaxForce()
	local frictionTorque: number = friction:getMaxTorque()
	local rope = love.physics.newRopeJoint(anchor, body, 0, 0, 100, 0, 80, false)
	rope:setMaxLength(rope:getMaxLength())
	local ropeLength: number = rope:getMaxLength()
	local pulley = love.physics.newPulleyJoint(anchor, body, 0, 0, 100, 0, 0, 40, 100, 60, 2, true)
	local pulleyGroundX1, pulleyGroundY1, pulleyGroundX2, pulleyGroundY2 = pulley:getGroundAnchors()
	local pulleyLengthA: number = pulley:getLengthA()
	local pulleyLengthB: number = pulley:getLengthB()
	local pulleyRatio: number = pulley:getRatio()
	local wheel = love.physics.newWheelJoint(anchor, body, 0, 0, 0, 20, 0, 1, false)
	wheel:setMotorEnabled(true)
	wheel:setMotorSpeed(2)
	wheel:setMaxMotorTorque(1000)
	wheel:setSpringFrequency(4)
	wheel:setSpringDampingRatio(0.5)
	local wheelTranslation: number = wheel:getJointTranslation()
	local wheelSpeed: number = wheel:getJointSpeed()
	local wheelTorque: number = wheel:getMotorTorque(60)
	local wheelFrequency: number = wheel:getSpringFrequency()
	local wheelDamping: number = wheel:getSpringDampingRatio()
	local mouse = love.physics.newMouseJoint(body, 0, 0)
	mouse:setTarget(40, 20)
	mouse:setMaxForce(1000)
	mouse:setFrequency(5)
	mouse:setDampingRatio(0.7)
	local mouseTargetX, mouseTargetY = mouse:getTarget()
	local mouseForce: number = mouse:getMaxForce()
	local mouseFrequency: number = mouse:getFrequency()
	local mouseDamping: number = mouse:getDampingRatio()
	mouse = love.physics.newMotorJoint(anchor, body, 0.4, true)
	mouse:setLinearOffset(20, 10)
	mouse:setAngularOffset(0.25)
	mouse:setMaxForce(1000)
	mouse:setMaxTorque(2000)
	mouse:setCorrectionFactor(0.6)
	print(mouse:getLinearOffset())
	print(mouse:getAngularOffset(), mouse:getMaxForce(), mouse:getMaxTorque(), mouse:getCorrectionFactor())
	mouse = love.physics.newGearJoint(revolute, prismatic, 2, true)
	mouse:setRatio(-2)
	print(mouse:getJoints())
	print(mouse:getRatio())
	local wheelAxisX, wheelAxisY = wheel:getAxis()
	local jointDestroyed: boolean = joint:isDestroyed()
	local first, second = joint:getBodies()
	local anchorX1, anchorY1, anchorX2, anchorY2 = joint:getAnchors()
	local reactionX, reactionY = joint:getReactionForce(60)
	local reactionTorque = joint:getReactionTorque(60)
	local collideConnected = joint:getCollideConnected()
	joint:setUserData({tag = "joint"})
	local jointData: any = joint:getUserData()
	joint:setLength(joint:getLength())
	joint:setFrequency(joint:getFrequency())
	joint:setDampingRatio(joint:getDampingRatio())
	local beginContact = function(fixtureA: any, fixtureB: any, contact: ContactLike)
		local contactFixtureA, contactFixtureB = contact:getFixtures()
		local childA, childB = contact:getChildren()
		local contactX, contactY = contact:getPositions()
		local normalX, normalY = contact:getNormal()
		contact:setFriction(contact:getFriction())
		contact:setRestitution(contact:getRestitution())
		contact:setTangentSpeed(contact:getTangentSpeed())
		contact:setEnabled(contact:isEnabled())
		print(fixtureA, fixtureB, contactFixtureA, contactFixtureB, childA, childB, contactX, contactY, normalX, normalY, contact:isTouching())
	end
	local postSolve = function(fixtureA: any, fixtureB: any, contact: any, ...: number)
		print(fixtureA, fixtureB, contact, select("#", ...))
	end
	world:setCallbacks(beginContact, nil, beginContact, postSolve)
	local beginValue, endValue, preValue, postValue = world:getCallbacks()
	print(beginValue, endValue, preValue, postValue)
	world:queryBoundingBox(0, 0, 200, 200, function(queriedFixture: any): boolean
		return queriedFixture == fixture
	end)
	world:rayCast(0, 0, 200, 200, function(hitFixture: any, x: number, y: number, normalX: number, normalY: number, fraction: number): number
		print(hitFixture, x, y, normalX, normalY)
		return fraction
	end)
	world:update(1 / 60, 8, 3)
	print(revoluteAngle, revoluteSpeed, revoluteTorque, revoluteReference, revoluteEnabled)
	print(prismaticTranslation, prismaticSpeed, prismaticForce, prismaticAxisX, prismaticAxisY, prismaticReference,
		weldFrequency, weldDamping, weldReference, frictionForce, frictionTorque, ropeLength,
		pulleyGroundX1, pulleyGroundY1, pulleyGroundX2, pulleyGroundY2, pulleyLengthA, pulleyLengthB, pulleyRatio)
	print(wheelTranslation, wheelSpeed, wheelTorque, wheelFrequency, wheelDamping, wheelAxisX, wheelAxisY)
	print(mouseTargetX, mouseTargetY, mouseForce, mouseFrequency, mouseDamping)
	if false then
		joint:destroy()
		fixture:destroy()
		body:destroy()
		world:destroy()
	end
	print(positionX, positionY, angularVelocity, linearDamping, angularDamping, mass, inertia,
		worldDestroyed, bodyDestroyed, fixtureDestroyed, jointDestroyed,
		anchorX1, anchorY1, anchorX2, anchorY2, reactionX, reactionY,
		reactionTorque, collideConnected, jointData,
		centerMassX, centerMassY, massDataMass, massDataInertia,
		localCenterX, localCenterY, worldCenterX, worldCenterY, fixedRotation,
		awake, sleepingAllowed, active, bullet,
		pointX, pointY, first, second, chainCount, chainX, chainY, edgeX, edgeY,
		previousX, previousY, nextX, nextY, polygonValid)
end

if false then
	checkFilesystemTypes()
	checkAudioTypes()
	checkDecoderTypes()
	checkMathTypes()
	checkDataTypes()
	checkQuadTypes()
	checkMeshTypes()
	checkShaderTypes()
	checkPhysicsTypes()
end

love.load = function()
	elapsed = 0.0
end

love.update = function(deltaTime: number)
	elapsed = elapsed + deltaTime
	local timerDelta: number = love.timer.getDelta()
	print(timerDelta)
end

love.draw = function()
	local current: number = elapsed
	love.graphics.setBlendMode("add", "alphamultiply")
	local blendMode, alphaMode = love.graphics.getBlendMode()
	local checkedBlendMode: string = blendMode
	local checkedAlphaMode: string = alphaMode
	love.graphics.setScissor(10, 20, 80, 40)
	love.graphics.setScissor()
	love.graphics.setColorMask(true, true, true, false)
	local maskRed, maskGreen, maskBlue, maskAlpha = love.graphics.getColorMask()
	print(maskRed, maskGreen, maskBlue, maskAlpha)
	love.graphics.setColorMask()
	love.graphics.stencil(function()
		love.graphics.rectangle("fill", 0, 0, 32, 32)
	end, "replace", 1)
	love.graphics.setStencilTest("equal", 1)
	local stencilCompare, stencilValue = love.graphics.getStencilTest()
	love.graphics.setStencilTest()
	love.graphics.clear(0.0, 0.0, 0.0, 1.0)
	love.graphics.setColor(1.0, 0.5, 0.25, 1.0)
	love.graphics.rectangle("fill", 10, 20, 100, 50)
	local font = love.graphics.newFont(18)
	love.graphics.setFont(font)
	local fontWidth: number = font:getWidth("Love")
	local fontHeight: number = font:getHeight()
	local baseline: number = font:getBaseline()
	local wrapWidth, wrapLines = font:getWrap("hello world", 60)
	love.graphics.print("hello", 10, 80)
	love.graphics.printf("hello world", 10, 110, 100, "center")
	print(current, checkedBlendMode, checkedAlphaMode, stencilCompare, stencilValue, fontWidth, fontHeight, baseline, wrapWidth, #wrapLines)
end
